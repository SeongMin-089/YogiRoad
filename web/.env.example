# 비워 두면 브라우저와 같은 origin의 /api를 사용합니다.
VITE_API_BASE_URL=

# 로컬 개발 중 /api 요청을 전달할 Spring Boot 주소입니다.
VITE_DEV_API_PROXY_TARGET=http://localhost:8080

# Kakao Developers에 현재 웹 origin을 등록한 JavaScript 키를 사용합니다.
VITE_KAKAO_JAVASCRIPT_KEY=

# 상가정보 API 키는 브라우저 번들에 노출하지 않습니다.
# backend/.env의 PUBLIC_STORE_API_KEY를 사용하세요.
